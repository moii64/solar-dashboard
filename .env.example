# ----> Điền giá trị thực của bạn vào các placeholder <...> <---
# Local (không Docker): sqlite:///./solar.db
# Docker Compose: postgresql+psycopg://solar_user:solar_pass@db:5432/solar_db
DATABASE_URL=postgresql+psycopg://solar_user:solar_pass@db:5432/solar_db
REDIS_URL=redis://redis:6379
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=solar/inverters/#
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=solar-dashboard-backend
ENABLE_MQTT_CONSUMER=0
MQTT_AUTO_CREATE_INVERTER=1
MAPBOX_TOKEN=<YOUR_MAPBOX_TOKEN>
# URL tile weather overlay cho frontend map (dùng template {z}/{x}/{y}, ví dụ OpenWeather precipitation)
# Ví dụ: https://tile.openweathermap.org/map/precipitation_new/{z}/{x}/{y}.png?appid=<YOUR_OPENWEATHER_API_KEY>
VITE_WEATHER_TILE_URL=
# Loại weather overlay: precipitation | clouds | temp
VITE_WEATHER_LAYER_KIND=precipitation
ENABLE_BACKGROUND_TELEMETRY=0
API_BASE_URL=http://localhost:8000
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_MODBUS_HOST=0.0.0.0
SIMULATOR_MODBUS_PORT=5020
SIMULATOR_INVERTER_ID=
SIMULATOR_INVERTER_NAME=Simulator Demo 01
SIMULATOR_INVERTER_LOCATION=Solar Việt Nam - Modbus Lab
SIMULATOR_DEVICE_TYPE=sungrow
SIMULATOR_IP_ADDRESS=127.0.0.1
